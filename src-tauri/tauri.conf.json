{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chest",
  "version": "0.1.0",
  "identifier": "app.chest.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chest",
        "width": 1150,
        "height": 800,
        "minWidth": 700,
        "minHeight": 580,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.modrinth.com https://media.forgecdn.net https://mediafilez.forgecdn.net; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwNTMxNUYzRDQzRTJBNzkKUldSNUtqN1U4eFZUSUxvNHZPV3lZRXlZa2prbldMS0sybXVuQ2xGaG9zeSt3bFA1blgyTVpnZDAK",
      "endpoints": [
        "https://github.com/gardengim/chest/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
