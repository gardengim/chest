{
  "name": "chest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "icons": "node scripts/generate-icons.mjs",
    "test": "playwright test",
    "test:core": "cargo test --manifest-path core/Cargo.toml",
    "check:core": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check:release": "node scripts/check-release-version.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "audit:candidate": "node scripts/audit-candidate.mjs",
    "licenses": "node scripts/generate-licenses.mjs",
    "check:licenses": "node scripts/check-licenses.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tauri-apps/cli": "^2.10.1",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "license": "MIT"
}
